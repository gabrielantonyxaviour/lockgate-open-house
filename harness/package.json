{
  "name": "@lockgate/harness",
  "private": true,
  "type": "module",
  "scripts": {
    "build:fixture": "forge build --root fixture",
    "pretest": "forge build --skip test --root ../contracts && forge build --root fixture",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preflight": "tsx ../scripts/preflight.ts",
    "preflight:sepolia": "tsx ../scripts/preflight.ts sepolia",
    "deploy:local": "tsx ../scripts/deploy-local.ts",
    "deploy:sepolia": "tsx ../scripts/deploy-sepolia.ts",
    "manifest": "tsx ../scripts/deployment-manifest.ts",
    "manifest:local": "tsx ../scripts/deployment-manifest.ts local",
    "bytecode": "tsx ../scripts/bytecode.ts",
    "checksum": "tsx ../scripts/checksum.ts",
    "checksum:verify": "tsx ../scripts/checksum.ts verify",
    "cleanup": "tsx ../scripts/cleanup.ts",
    "report": "tsx ../scripts/report.ts",
    "anvil": "tsx ../scripts/start-anvil.ts",
    "serve": "tsx src/server.ts",
    "demo": "tsx src/cli.ts demo.all",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "viem": "^2.37.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
